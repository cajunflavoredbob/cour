{
  "name": "cour",
  "version": "1.2.3",
  "description": "Pick the season together",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch cmd/reely/main.ts",
    "build:server": "tsc",
    "build:ui": "pnpm --filter cour-ui build",
    "build": "pnpm run build:server && pnpm run build:ui",
    "serve": "pnpm run build && NODE_ENV=production node --env-file=.env dist/cmd/reely/main.js",
    "typecheck:server": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:ui": "pnpm --filter cour-ui typecheck",
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:tests && pnpm run typecheck:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "js-yaml": "^5.2.2",
    "minimist": "^1.2.8",
    "pino": "^9.6.0",
    "ws": "^8.21.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "fast-uri": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "brace-expansion": ">=5.0.6",
      "picomatch": ">=4.0.4"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
